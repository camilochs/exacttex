/target
/crates/xtex-verify/target/
**/*.rs.bk
Cargo.lock.bak

# Build artefacts from the test corpus
/tests/corpus/**/build/
*.aux
*.log
# Fixtures are inputs, not build output. `*.log` silently swallowed a
# committed test's fixture once; CI failed while local runs passed.
!tests/fixtures/**/*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

.DS_Store

# Rust
/target

# Experiments build on their own
/tests/experiments/**/target/
/tests/experiments/**/Cargo.lock

# The docs site's build artifacts, also ignored from its own .gitignore once
# the site branch merges — doubled here so a branch cut from main before that
# can never sweep node_modules into a commit again (it happened twice).
site/node_modules/
site/dist/
site/.astro/
site/src/content/docs/
site/public/assets/
