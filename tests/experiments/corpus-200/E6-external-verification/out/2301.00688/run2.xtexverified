tical mechanics exposes new information and provides an unfamiliar perspective on traditional optimization problems and methods.","url":"http://www.sciencemag.org/cgi/content/abstract/220/4598/671","eprint":"http://www.sciencemag.org/cgi/reprint/220/4598/671.pdf"},"diffs":[]},{"kind":"bib-entry","target":"slug_tuner","verdict":"partial","source":"crossref-query","fetched_at":"2026-09-12T00:31:15Z","response_hash":"5eacea1397f7ff47","fields":{"author":"{FOCUS Microwaves}","title":"{MPT, a universal Multi-Purpose Tuner}","howpublished":"Product Note","month":"","year":"2004","note":""},"diffs":[{"field":"authors","in_document":"{FOCUS Microwaves}","in_source":"C. Tsironis and R. Meierer and B. Hosein and T. Beauchamp and R. Jallad","severity":"high"}]},{"kind":"bib-entry","target":"solid_state_radio_eng","verdict":"unverified","source":"none","fetched_at":"2026-09-12T00:31:15Z","response_hash":"","fields":{"author":"H.L. Krauss and C.W. Bostian and F.H. Raab","title":"Solid State Radio Engineering","publisher":"John Wiley \\& Sons, Inc.","year":"1980","address":"111 River St. Hoboken, NJ 07030","edition":"1st","month":"March"},"diffs":[],"failure_note":"not found at the registries — books published before DOIs often are not registered; the entry may still be correct"},{"kind":"bib-entry","target":"sos-qc-92","verdict":"verified","source":"crossref-query","fetched_at":"2026-09-12T00:31:15Z","response_hash":"7842bf0df870cbc3","fields":{"author":"H. S. Seung and M. Opper and H. Sompolinsky","title":"Query by committee","booktitle":"Proc. 5th Annu. Workshop on Comput. Learning Theory","publisher":"ACM Press","year":"1992","pages":"287--294"},"diffs":[]},{"kind":"bib-entry","target":"spectrally_clean_radar","verdict":"verified","source":"openalex","fetched_at":"2026-09-12T00:31:15Z","response_hash":"71048ef8545afca1","fields":{"author":"Faust, H.H. and Connolly, B. and Firestone, T.M. and Chen, R.C. and Cantrell, B.H. and Mokole, E.L.","booktitle":"Radar Conference, 2004. 