":"2026-09-12T00:30:07Z","response_hash":"177087f24e392cc2","fields":{"author":"Qizhe Xie and\n               Eduard H. Hovy and\n               Minh{-}Thang Luong and\n               Quoc V. Le","title":"Self-training with Noisy Student improves ImageNet classification","journal":"CoRR","volume":"abs/1911.04252","year":"2019"},"diffs":[{"field":"year","in_document":"2019","in_source":"2020","severity":"medium"}]},{"kind":"bib-entry","target":"imageadverserial","verdict":"unverified","source":"none","fetched_at":"2026-09-12T00:30:07Z","response_hash":"","fields":{"author":"Ganin, Yaroslav and Lempitsky, Victor","title":"Unsupervised Domain Adaptation by Backpropagation","year":"2015","publisher":"JMLR.org","booktitle":"Proc. ICML","pages":"1180–1189","numpages":"10","location":"Lille, France","series":"ICML'15"},"diffs":[],"failure_note":"not found at the registries — books published before DOIs often are not registered; the entry may still be correct"},{"kind":"bib-entry","target":"inbook_bulg","verdict":"verified","source":"openalex","fetched_at":"2026-09-12T00:30:07Z","response_hash":"b1dba319ed5a7684","fields":{"author":"Geneva, Diana and Shopov, Georgi and Mihov, Stoyan","year":"2019","month":"09","pages":"188-197","title":"Building an ASR Corpus Based on Bulgarian Parliament Speeches","isbn":"978-3-030-31371-5","doi":"10.1007/978-3-030-31372-2_16"},"diffs":[]},{"kind":"bib-entry","target":"ivectors","verdict":"verified","source":"crossref-query","fetched_at":"2026-09-12T00:30:07Z","response_hash":"e54c129b2b512bf1","fields":{"author":"Gupta, Vishwa and Kenny, Patrick and Ouellet, Pierre and Stafylakis, Themos","booktitle":"Proc. ICASSP","title":"I-vector-based speaker adaptation of deep neural networks for French broadcast audio transcription","year":"2014"},"diffs":[]},{"kind":"bib-entry","target":"jegou2010product","verdict":"partial","source":"crossref-query","fetched_at":"2026-09-12T00:30:07Z","response_hash":"242e5822af00e25d","fields":{"title":"Product quantization for nearest neighbor search","author":"Jegou, Herve and Douze, Matthijs and Schmid, Cordelia","journal":"IEEE transactions on pattern analysis and machine intelligence","volume":"33","number":"1","pages":"117--128","year":"2010","publisher":"IEEE"},"diffs":[{"field":"year","in_document":"2010","in_source":"2011","severity":"medium"}]},{"kind":"bib-entry","target":"karouzos-etal-2021-udalm","verdict":"verified","source":"openalex","fetched_at":"2026-09-12T00:30:07Z","response_hash":"b1dba319ed5a7684","fields":{"title":"{UDALM}: Unsupervised Domain Adaptation through Language Modeling","author":"Karouzos, Constantinos  and\n      Paraskevopoulos, Georgios  and\n      Potamianos, Alexandros","booktitle":"Proc.  Association for Computational Linguistics: Human Language Technologies","month":"jun","year":"2021","address":"Online","publisher":"Association for Computational Linguistics","url":"https://aclanthology.org/2021.naacl-main.203","doi":"10.18653/v1/2021.naacl-main.203","pages":"2579--2590","abstract":"In this work we explore Unsupervised Domain Adaptation (UDA) of pretrained language models for downstream tasks. We introduce UDALM, a fine-tuning procedure, using a mixed classification and Masked Language Model loss, that can adapt to the target domain distribution in a robust and sample efficient manner. Our experiments show that performance of models trained with the mixed loss scales with the amount of available target data and the mixed loss can be effectively used as a stopping criterion during UDA training. Furthermore, we discuss the relationship between A-distance and the target error and explore some limitations of the Domain Adversarial Training approach. Our method is evaluated on twelve domain pairs of the Amazon Reviews Sentiment dataset, yielding 91.74{\\%} accuracy, which is an 1.11{\\%} absolute improvement over the state-of-the-art."},"diffs":[]},{"kind":"bib-entry","target":"kim22e_interspeech","verdict":"verified","source":"openalex","fetched_at":"2026-09-12T00:30:07Z","response_hash":"b1dba319ed5a7684","fields":{"author":"Jounghee Kim and Pilsung Kang","title":"{K-Wav2vec 2.0: Automatic Speech Recognition based on Joint Decoding of Graphemes and Syllables}","year":"2022","booktitle":"Proc. Interspeech","pages":"4945--4949","doi":"10.21437/Interspeech.2022-547"},"diffs":[]},{"kind":"bib-entry","target":"ko2017study","verdict":"verified","source":"crossref-query","fetched_at":"2026-09-12T00:30:07Z","response_hash":"68e17008eaf5b986","fields":{"title":"A study on data augmentation of reverberant speech for robust speech recognition","author":"Tom Ko et al.","booktitle":"Proc. ICASSP","pages":"5220--5224","year":"2017","organization":"IEEE"},"diffs":[]},{"kind":"bib-entry","target":"kratochvil-etal-2020-large","verdict":"unverified","source":"none","fetched_at":"2026-09-12T00:30:07Z","response_hash":"","fields":{"title":"Large Corpus of {C}zech Parliament Plenary Hearings","author":"Kratochvil, Jonas  and\n      Polak, Peter  and\n      Bojar, Ondrej","booktitle":"Proc. of the 12th Language Resources and Evaluation Conf.","month":"may","year":"2020","address":"Marseille, France","publisher":"European Language Resources Association","url":"https://aclanthology.org/2020.lrec-1.781","pages":"6363--6367","language":"English","isbn":"979-10-95546-34-4"},"diffs":[],"failure_note":"not found at the registries — books published before DOIs often are not registered; the entry may still be correct"},{"kind":"bib-entry","target":"las","verdict":"verified","source":"openalex","fetched_at":"2026-09-12T00:30:07Z","response_hash":"b1dba319ed5a7684","fields":{"author":"Chan, William and Jaitly, Navdeep and Le, Quoc and Vinyals, Oriol","booktitle":"Proc. ICASSP","title":"Listen, attend and spell: A neural network for large vocabulary conversational speech recognition","year":"2016","volume":"","number":"","pages":"4960-4964","doi":"10.1109/ICASSP.2016.7472621"},"diffs":[]},{"kind":"bib-entry","target":"lin2022liste